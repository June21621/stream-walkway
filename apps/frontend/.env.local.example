# 백엔드 게이트웨이 주소.
# 빌드 타임 데이터 페칭과 클라이언트 fetch 양쪽에서 쓰인다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 캡처 이미지 base URL. 버킷 이름까지 포함시킨다.
#
# API가 주는 image_path 는 URL이 아니라 `captures/1/7/....jpg` 형태의 객체 키다.
# 버킷 이름도 `captures` 라서 실제 주소에 captures 가 두 번 들어간다.
# base에 버킷을 포함시키면 그 중복이 그대로 맞아떨어진다.
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:9000/captures
