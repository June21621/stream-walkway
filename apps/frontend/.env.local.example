# 백엔드 게이트웨이 주소.
# 빌드 타임 데이터 페칭과 클라이언트 fetch 양쪽에서 쓰인다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 캡처 이미지 base URL. 버킷 이름까지 포함시킨다.
#
# API가 주는 image_path 는 URL이 아니라 `captures/1/7/....jpg` 형태의 객체 키다.
# 버킷 이름도 `captures` 라서 실제 주소에 captures 가 두 번 들어간다.
# base에 버킷을 포함시키면 그 중복이 그대로 맞아떨어진다.
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:9000/captures

# 네이버 지도 Client ID (NCP 콘솔 > Maps > Application > Web Dynamic Map).
# 비워두면 지도 자리에 안내 문구가 뜨고 목록으로는 계속 쓸 수 있다.
#
# 발급 시 서비스 URL(도메인)을 등록해야 한다 - 등록 안 된 도메인에서는 인증 실패한다.
#   http://localhost:3000   next dev
#   http://localhost:4000   npm run preview
#   https://<배포도메인>
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
