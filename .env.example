# 공통
ENVIRONMENT=development
LOG_LEVEL=INFO

# DB
POSTGRES_USER=stream_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stream_db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_pw
REDIS_PORT=6379

# MinIO (S3 호환 오브젝트 스토리지)
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=captures
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# CAPTURE_SOURCE=file일 때만 쓰인다. 컨테이너 안에서 보이는 경로여야 하므로
# docker-compose.yml에 소스 영상을 볼륨으로 마운트해야 한다.
# CAPTURE_FILE_PATH=/videos/sample.mp4

# Kafka (KRaft)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Ports
BACKEND_PORT=8080
WRITER_PORT=8002
READER_PORT=8001
YOUTUBE_PORT=3001
ML_PORT=5001

# Spring 공통
SPRING_PROFILES_ACTIVE=docker

# 캡처 소스: testsrc(컬러바) | file(직접 촬영 영상) | hls(공개 스트림)
CAPTURE_SOURCE=testsrc
# file 모드에서만 쓰인다. 호스트가 아니라 컨테이너 경로다(media/ 가 /media 로 마운트됨)
CAPTURE_FILE_PATH=
# 지점마다 다른 프레임이 나오도록 오프셋을 흩는다: base + (step * trailId) % span
CAPTURE_FILE_OFFSET_SEC=10
CAPTURE_FILE_OFFSET_STEP_SEC=37
CAPTURE_FILE_OFFSET_SPAN_SEC=100
