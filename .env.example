# 공통
ENVIRONMENT=development
LOG_LEVEL=INFO

# DB
POSTGRES_USER=stream_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stream_db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_pw
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=stream_user
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
WRITER_PORT=8002
READER_PORT=8001
YOUTUBE_PORT=3001
ML_PORT=5001

# Spring 공통
SPRING_PROFILES_ACTIVE=docker

# 외부 접근용 (프론트가 호출)
BACKEND_BASE_URL=http://localhost:8080
